+def rj_stops_near(lat, lon, radius_m, want_min=6):
+    rows = rj_stations()
+    used = float(radius_m)
+    for r in (radius_m, radius_m * 2, radius_m * 4, 1500.0, 3000.0, 6000.0):
+        out = []
+        for st in rows:
+            try:
+                d = _metres(lat, lon, st["lat"], st["lon"])
+            except Exception:
+                continue
+            if d <= r:
+                o = dict(st)
+                o["dist"] = int(round(d))
+                out.append(o)
+        used = float(r)
+        if len(out) >= want_min or not want_min:
+            break
+    out.sort(key=lambda x: x["dist"])
+    return out[:60], used
+
