+def _rj_secs(t):
+    """'20:00:00.0000000' -> seconds since midnight."""
+    try:
+        h, m, rest = str(t).split(":")[:3]
+        return int(h) * 3600 + int(m) * 60 + int(float(rest))
+    except Exception:
+        return None
+
